# Copy to application-test.yml and fill in the database connection locally.
# This template is safe to keep in version control.
spring:
  datasource:
    url: jdbc:mysql://TEST_DB_HOST:3306/hrms_test?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
    username: TEST_DB_USERNAME
    password: TEST_DB_PASSWORD
hr:
  seed-demo: false
  allowed-origins: http://TEST_FRONTEND_HOST
