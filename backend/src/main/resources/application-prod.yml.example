# Copy to application-prod.yml and fill in the database connection locally.
# Production also requires HR_ENCRYPTION_KEY, HR_USER_CENTER_BASE_URL and HR_ALLOWED_ORIGINS.
spring:
  datasource:
    url: jdbc:mysql://PROD_DB_HOST:3306/hrms?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
    username: PROD_DB_USERNAME
    password: PROD_DB_PASSWORD
server:
  servlet:
    session:
      cookie:
        secure: true
hr:
  encryption-key: ${HR_ENCRYPTION_KEY}
  user-center-base-url: ${HR_USER_CENTER_BASE_URL}
  seed-demo: false
  allowed-origins: ${HR_ALLOWED_ORIGINS}
