# Development configuration; run scripts/bootstrap-dev.ps1 to generate local secrets.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://127.0.0.1:3307/hrms_dev?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=hr_app
DB_PASSWORD=replace-with-your-database-password
# Base64 encoded, cryptographically random 32-byte AES key. Back up with the database.
HR_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
HR_SEED_DEMO=true
HR_USER_CENTER_BASE_URL=https://test.medianos.com/smart-site-cloud/user
HR_UPLOAD_DIRECTORY=../.local/uploads
HR_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:8090,http://localhost:8090
SERVER_PORT=8090
TEST_DB_URL=jdbc:mysql://127.0.0.1:3307/hrms_test?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
